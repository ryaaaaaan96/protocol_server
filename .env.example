# Runtime role must be non-superuser / NOBYPASSRLS, and must not own the schema.
DATABASE_URL=postgres://protocol_app:CHANGE_APP_PASSWORD@127.0.0.1:5432/protocol_studio
# Used only by `cargo run -- migrate`, never by the running HTTP service.
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_DB_PASSWORD@127.0.0.1:5432/protocol_studio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
BIND_ADDR=127.0.0.1:8080
COOKIE_SECURE=false
STATIC_DIR=frontend/dist
RUST_LOG=protocol_server=info,tower_http=info
# UI field defaults and per-project overrides (relative to the working directory).
POINT_TABLE_CONFIG=config/point-tables.json
PROJECT_CONFIG_DIR=config/projects
# Docker Compose only (use the same app password as DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
POSTGRES_APP_PASSWORD=CHANGE_APP_PASSWORD
