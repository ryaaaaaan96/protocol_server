# Runtime role must be non-superuser / NOBYPASSRLS, and must not own the schema.
DATABASE_URL=postgres://protocol_app:CHANGE_APP_PASSWORD@127.0.0.1:5432/protocol_platform
# Platform database only. Project databases use the same server/roles and their registry database_name.
# Used for schema migration, project DB provisioning and export; never request SQL.
# Admin needs CREATEDB, BYPASSRLS and schema/function ownership (or superuser).
# One-time split-databases.mjs requires superuser for connection isolation.
# Runtime role must have none of those privileges and must not own tables.
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_DB_PASSWORD@127.0.0.1:5432/protocol_platform
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
BIND_ADDR=127.0.0.1:8080
COOKIE_SECURE=false
STATIC_DIR=frontend/dist
RUST_LOG=protocol_server=info,tower_http=info
# Parent of self-contained project folders (relative to the working directory).
PROJECT_CONFIG_DIR=config
# Optional absolute PostgreSQL client paths; otherwise search PATH.
# Export uses pg_dump; importing a project Dump uses pg_restore without a DB connection.
# PG_DUMP_BIN=/usr/lib/postgresql/18/bin/pg_dump
# PG_RESTORE_BIN=/usr/lib/postgresql/18/bin/pg_restore
# Docker Compose only (use the same app password as DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
POSTGRES_APP_PASSWORD=CHANGE_APP_PASSWORD
