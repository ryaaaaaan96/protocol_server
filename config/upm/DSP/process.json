{
  "version": 1,
  "enabled": true,
  "label": "DSP内部数据",
  "description": "维护 DSP 内部点的编号、枚举、类型、长度、默认值和范围。UPP 转发通过固定记录 ID 引用内部点；分组由项目 JSON 配置。",
  "columns": [
    "name",
    "group_name",
    "resolved_sig_id",
    "enum_name",
    "data_type",
    "element_count",
    "byte_length",
    "unit",
    "default_value",
    "min_value",
    "max_value",
    "boot_restore",
    "manual_restore",
    "process_enabled",
    "flags",
    "callback",
    "forward_count",
    "notes"
  ],
  "editor": [
    "name",
    "group_key",
    "enum_name",
    "sig_id",
    "internal_type",
    "element_count",
    "unit",
    "default_value",
    "min_value",
    "max_value",
    "boot_restore",
    "manual_restore",
    "process_enabled",
    "flags",
    "callback",
    "notes"
  ],
  "ordering": {
    "mode": "display",
    "group_by": []
  },
  "inline": {
    "name": "name",
    "enum_name": "enum_name",
    "element_count": "element_count",
    "unit": "unit",
    "default_value": "default_value",
    "min_value": "min_value",
    "max_value": "max_value",
    "boot_restore": "boot_restore",
    "manual_restore": "manual_restore",
    "process_enabled": "process_enabled",
    "flags": "flags",
    "callback": "callback",
    "notes": "notes",
    "group_name": "group_key",
    "resolved_sig_id": "sig_id",
    "data_type": "internal_type"
  },
  "fields": {
    "name": {
      "label": "信号名称"
    },
    "group_name": {
      "label": "点表分组"
    },
    "group_key": {
      "label": "点表分组",
      "reference": "native_groups",
      "default": "LOCAL"
    },
    "resolved_sig_id": {
      "label": "sigID"
    },
    "sig_id": {
      "label": "数字 sigID",
      "type": "number",
      "nullable": true,
      "hint": "留空表示暂未分配；关联使用固定记录 ID，修改编号不会改变关联。"
    },
    "enum_name": {
      "label": "枚举"
    },
    "data_type": {
      "label": "内部类型"
    },
    "internal_type": {
      "label": "内部类型",
      "options": [
        "U8",
        "U16",
        "S16",
        "U32",
        "S32",
        "F32",
        "STRING"
      ],
      "default": "F32"
    },
    "element_count": {
      "label": "元素数量",
      "type": "number",
      "default": 1,
      "hint": "数组填写元素个数，字符串填写字节容量；标量填 1。"
    },
    "byte_length": {
      "label": "内部字节数",
      "hint": "根据内部类型和元素数量计算。"
    },
    "unit": {
      "label": "单位",
      "nullable": true
    },
    "default_value": {
      "label": "默认值",
      "nullable": true,
      "hint": "直接保存点默认值；留空表示未指定。"
    },
    "min_value": {
      "label": "下限",
      "nullable": true
    },
    "max_value": {
      "label": "上限",
      "nullable": true
    },
    "boot_restore": {
      "label": "上电恢复默认值",
      "type": "boolean",
      "default": false
    },
    "manual_restore": {
      "label": "允许手动恢复默认值",
      "type": "boolean",
      "default": false
    },
    "process_enabled": {
      "label": "加入处理表",
      "type": "boolean",
      "default": true
    },
    "flags": {
      "label": "处理标志",
      "default": "0"
    },
    "callback": {
      "label": "回调函数",
      "default": "NULL"
    },
    "forward_count": {
      "label": "转发绑定数"
    },
    "notes": {
      "label": "备注",
      "nullable": true
    }
  }
}
