        ]
      },
      "DSP": {
        "tables": [
          "process",
          "transmit"
        ]
      },
      "IDU_T": {
        "tables": [
          "process",
          "collect",
          "transmit",
          "fields",
          "data",
          "routes",
          "expansion",
          "links",
          "endpoints",
          "contexts",
          "groups"
        ]
      },
      "IDU_R": {
        "tables": [
          "process",
          "collect",
          "transmit",
          "fields",
          "data",
          "routes",
          "expansion",
          "links",
          "endpoints",
          "contexts",
