{
  "version": 1,
  "enabled": true,
  "label": "处理点表",
  "description": "统一维护内部信号、默认值、上下限及恢复策略；采集与转发通过固定记录 ID 引用。",
  "columns": [
    "name",
    "group_name",
    "resolved_sig_id",
    "enum_name",
    "data_type",
    "byte_length",
    "unit",
    "default_value",
    "min_value",
    "max_value",
    "boot_restore",
    "manual_restore",
    "flags",
    "callback",
    "collection_count",
    "forward_count"
  ],
  "editor": [
    "name",
    "group_id",
    "data_item_id",
    "enum_name",
    "sig_id",
    "sig_symbol",
    "internal_type",
    "flags",
    "callback",
    "process_enabled",
    "default_value",
    "min_value",
    "max_value",
    "boot_restore",
    "manual_restore"
  ],
  "ordering": {
    "mode": "display",
    "group_by": [
      "group_id"
    ]
  },
  "inline": {
    "name": "name",
    "enum_name": "enum_name",
    "flags": "flags",
    "callback": "callback",
    "default_value": "default_value",
    "min_value": "min_value",
    "max_value": "max_value",
    "boot_restore": "boot_restore",
    "manual_restore": "manual_restore",
    "group_name": "group_id",
    "resolved_sig_id": "sig_id",
    "data_type": "internal_type"
  },
  "fields": {
    "name": {
      "label": "信号名称"
    },
    "group_name": {
      "label": "点表分组"
    },
    "resolved_sig_id": {
      "label": "sigID"
    },
    "enum_name": {
      "label": "枚举"
    },
    "data_type": {
      "label": "内部类型"
    },
    "byte_length": {
      "label": "内部字节数"
    },
    "unit": {
      "label": "单位"
    },
    "default_value": {
      "label": "默认值覆盖",
      "nullable": true,
      "hint": "留空继承数据定义；表格展示生效值。",
      "column_label": "默认值"
    },
    "min_value": {
      "label": "下限覆盖",
      "nullable": true,
      "hint": "留空继承数据定义；表格展示生效值。",
      "column_label": "下限"
    },
    "max_value": {
      "label": "上限覆盖",
      "nullable": true,
      "hint": "留空继承数据定义；表格展示生效值。",
      "column_label": "上限"
    },
    "flags": {
      "label": "处理标志",
      "default": "0"
    },
    "callback": {
      "label": "回调函数",
      "default": "NULL"
    },
    "collection_count": {
      "label": "采集绑定数"
    },
    "forward_count": {
      "label": "转发绑定数"
    },
    "group_id": {
      "label": "点表分组",
      "reference": "groups",
      "type": "number"
    },
    "data_item_id": {
      "label": "数据来源定义",
      "reference": "data",
      "type": "number",
      "hint": "定义提供类型、长度、单位和默认范围，可由多个点共享。"
    },
    "sig_id": {
      "label": "数字 sigID",
      "type": "number",
      "nullable": true,
      "hint": "数字与公共符号二选一；引用通过固定记录 ID 关联。"
    },
    "sig_symbol": {
      "label": "公共 sigID 符号",
      "nullable": true
    },
    "internal_type": {
      "label": "内部类型覆盖",
      "nullable": true,
      "options": [
        "U8",
        "U16",
        "S16",
        "U32",
        "S32",
        "F32",
        "STRING"
      ]
    },
    "process_enabled": {
      "label": "加入处理表",
      "type": "boolean",
      "default": true
    },
    "boot_restore": {
      "label": "上电恢复默认值",
      "type": "boolean",
      "default": false
    },
    "manual_restore": {
      "label": "允许手动恢复默认值",
      "type": "boolean",
      "default": false
    },
    "contexts": {
      "label": "设备上下文"
    },
    "range_inherited": {
      "label": "继承范围"
    }
  }
}
