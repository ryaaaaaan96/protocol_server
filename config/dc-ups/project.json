{
  "version": 1,
  "key": "dc-ups",
  "name": "DC-UPS",
  "description": "AIDC · 本地控制器与 DSP 点表的统一数据空间",
  "workbook": "sources/DC-UPS测点数据表.xlsx",
  "topology": {
    "version": 3,
    "board_types": [
      {
        "code": "CSU",
        "name": "CSU 主控板",
        "model_code": "CSU",
        "directory": "CSU"
      },
      {
        "code": "UPM",
        "name": "UPM 控制板",
        "model_code": "UPM_ARM",
        "directory": "UPM",
        "point_storage": "native",
        "point_groups": [
          {
            "code": "LOCAL",
            "name": "UPM 本地设备",
            "devices": [
              {
                "code": "LOCAL",
                "name": "UPM 本地设备",
                "dev_id": 0,
                "modbus_base": 0
              }
            ],
            "collect_enabled": false
          },
          {
            "code": "DSP",
            "name": "DSP 设备共享模板",
            "devices": [
              {
                "code": "DSP1",
                "name": "DSP 设备 1",
                "dev_id": 1,
                "modbus_base": 50000
              },
              {
                "code": "DSP2",
                "name": "DSP 设备 2",
                "dev_id": 2,
                "modbus_base": 51000
              },
              {
                "code": "DSP3",
                "name": "DSP 设备 3",
                "dev_id": 3,
                "modbus_base": 52000
              },
              {
                "code": "DSP4",
                "name": "DSP 设备 4",
                "dev_id": 4,
                "modbus_base": 53000
              },
              {
                "code": "DSP5",
                "name": "DSP 设备 5",
                "dev_id": 5,
                "modbus_base": 54000
              },
              {
                "code": "DSP6",
                "name": "DSP 设备 6",
                "dev_id": 6,
                "modbus_base": 55000
              },
              {
                "code": "DSP7",
                "name": "DSP 设备 7",
                "dev_id": 7,
                "modbus_base": 56000
              },
              {
                "code": "DSP8",
                "name": "DSP 设备 8",
                "dev_id": 8,
                "modbus_base": 57000
              }
            ],
            "collect_enabled": true
          }
        ],
        "point_endpoints": [
          {
            "code": "DSP_UPP",
            "name": "UPM-DSP UPP 采集",
            "protocol": "UPP",
            "direction": "collect",
            "subset_of": {
              "board_key": "DSP",
              "endpoint_key": "UPP_SERVICE"
            }
          },
          {
            "code": "MODBUS_SERVICE",
            "name": "Modbus 对外表",
            "protocol": "MODBUS"
          },
          {
            "code": "UPP_SERVICE",
            "name": "CSU-UPM UPP 对外表",
            "protocol": "UPP"
          }
        ],
        "point_rules": {
          "raw_representation": true,
          "inherit_name": true,
          "source_range_warnings": true,
          "warn_missing_sig_id": true,
          "null_callbacks": [
            "0"
          ]
        },
        "workbook_import": "workbook.json"
      },
      {
        "code": "DSP",
        "name": "DSP 功率板",
        "model_code": "DSP",
        "directory": "DSP",
        "point_storage": "native",
        "point_groups": [
          {
            "code": "LOCAL",
            "name": "DSP 内部数据",
            "collect_enabled": false
          }
        ],
        "point_endpoints": [
          {
            "code": "UPP_SERVICE",
            "name": "UPP 转发表",
            "protocol": "UPP"
          }
        ],
        "point_rules": {
          "inherit_name": true
        },
        "workbook_import": "workbook.json"
      },
      {
        "code": "IDU_T",
        "name": "变压器 IDU",
        "model_code": "IDU_TRANSFORMER",
        "directory": "IDU_T"
      },
      {
        "code": "IDU_R",
        "name": "整流模块 IDU",
        "model_code": "IDU_RECTIFIER",
        "directory": "IDU_R"
      },
      {
        "code": "UPM_DEMO",
        "name": "upm-demo",
        "model_code": "UPM_DEMO",
        "directory": "upm-demo",
        "point_storage": "derived",
        "point_groups": [
          {
            "code": "LOCAL",
            "name": "UPM完整采集",
            "collect_enabled": true
          }
        ],
        "point_endpoints": [
          {
            "code": "UPM_MODBUS",
            "name": "UPM Modbus采集",
            "protocol": "MODBUS",
            "direction": "collect"
          }
        ]
      }
    ],
    "roots": [
      {
        "type": "CSU",
        "quantity": 1
      },
      {
        "type": "UPM_DEMO",
        "quantity": 1
      }
    ],
    "mounts": [
      {
        "parent": "CSU",
        "child": "UPM",
        "quantity": 24,
        "connections": [
          {
            "protocol": "MODBUS",
            "transport": "CANFD"
          },
          {
            "protocol": "UPP",
            "transport": "CANFD"
          }
        ]
      },
      {
        "parent": "UPM_DEMO",
        "child": "UPM",
        "quantity": 24,
        "connections": [
          {
            "protocol": "MODBUS",
            "transport": "RS485"
          }
        ]
      },
      {
        "parent": "UPM",
        "child": "DSP",
        "quantity": 8,
        "connections": [
          {
            "protocol": "UPP",
            "transport": "CAN"
          }
        ]
      },
      {
        "parent": "CSU",
        "child": "IDU_T",
        "quantity": 1,
        "connections": [
          {
            "protocol": "MODBUS",
            "transport": "RS485"
          }
        ]
      },
      {
        "parent": "CSU",
        "child": "IDU_R",
        "quantity": 4,
        "connections": [
          {
            "protocol": "MODBUS",
            "transport": "RS485"
          }
        ]
      }
    ]
  },
  "workspace": {
    "boards": {
      "CSU": {
        "tables": []
      },
      "UPM": {
        "tables": [
          "process",
          "collect",
          "transmit"
        ]
      },
      "DSP": {
        "tables": [
          "process",
          "transmit"
        ]
      },
      "IDU_T": {
        "tables": []
      },
      "IDU_R": {
        "tables": []
      },
      "UPM_DEMO": {
        "tables": [
          "collect"
        ]
      }
    }
  },
  "workbook_boards": [
    "DSP",
    "UPM"
  ]
}
