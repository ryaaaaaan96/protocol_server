{
  "version": 1,
  "enabled": true,
  "label": "采集点表",
  "description": "对应 UPM-DSP采集数据。LOCAL 不建立采集记录；※ 参数保持为空。",
  "behavior": {
    "engine": "javascript",
    "script_file": "collect.js",
    "parameters": {},
    "source_tables": ["forward"],
    "editable_fields": ["base_address"],
    "metadata_fields": ["base_address"],
    "project_fields": ["base_address"],
    "owned_fields": []
  },
  "columns": [
    "signal_name",
    "enum_name",
    "resolved_sig_id",
    "upp_model",
    "address",
    "base_address",
    "wire_type",
    "wire_length",
    "scale",
    "access",
    "byte_order",
    "acquisition_mode",
    "poll_interval",
    "set_priority",
    "scan_priority"
  ],
  "editor": [
    "process_point_id",
    "endpoint_key",
    "upp_model",
    "address",
    "base_address",
    "wire_type",
    "wire_length",
    "scale",
    "access",
    "byte_order",
    "acquisition_mode",
    "poll_interval",
    "set_priority",
    "scan_priority"
  ],
  "ordering": {
    "mode": "display",
    "group_by": [
      "endpoint_key",
      "group_key",
      "upp_model"
    ]
  },
  "inline": {
    "upp_model": "upp_model",
    "address": "address",
    "base_address": "base_address",
    "wire_type": "wire_type",
    "wire_length": "wire_length",
    "scale": "scale",
    "access": "access",
    "byte_order": "byte_order",
    "acquisition_mode": "acquisition_mode",
    "poll_interval": "poll_interval",
    "set_priority": "set_priority",
    "scan_priority": "scan_priority"
  },
  "fields": {
    "base_address": {
      "label": "Base 地址",
      "type": "number",
      "nullable": true,
      "hint": "Modbus 测点偏移，单位为寄存器；修改后联动对应转发。首次显示当前转发偏移，保存后写入本采集记录；留空解除联动并保留当前转发偏移。"
    },
    "enum_name": {
      "label": "ENMU"
    },
    "device_addresses": {
      "label": "设备地址"
    },
    "signal_name": {
      "label": "内部点"
    },
    "process_point_id": {
      "label": "内部点",
      "type": "number",
      "reference": "process_points"
    },
    "endpoint_key": {
      "label": "协议端点",
      "reference": "endpoints"
    },
    "upp_model": {
      "label": "UPP 模型号",
      "type": "number",
      "default": 0
    },
    "address": {
      "label": "协议地址 / 偏移",
      "type": "number",
      "default": 0,
      "hint": "UPP 按字节；Modbus 按寄存器。DSP 模板为相对偏移，设备基址定义于 project.json。"
    },
    "wire_type": {
      "label": "通信类型",
      "options": [
        "U8",
        "U16",
        "S16",
        "U32",
        "S32",
        "F32",
        "STRING"
      ],
      "default": "U16"
    },
    "wire_length": {
      "label": "协议字节数",
      "type": "number",
      "default": 2
    },
    "scale": {
      "label": "精度",
      "type": "number",
      "default": 1
    },
    "access": {
      "label": "读写权限",
      "options": [
        "RO",
        "RW",
        "WO"
      ],
      "default": "RO"
    },
    "byte_order": {
      "label": "字节序",
      "type": "number",
      "default": 0
    },
    "acquisition_mode": {
      "label": "采集方式",
      "options": [
        "poll",
        "upload"
      ],
      "default": "poll",
      "hint": "poll 为主动轮询，upload 为接收 DSP 上报。"
    },
    "poll_interval": {
      "label": "UPP 轮询间隔",
      "type": "number",
      "nullable": true
    },
    "set_priority": {
      "label": "设置优先级",
      "type": "number",
      "nullable": true
    },
    "scan_priority": {
      "label": "轮询优先级",
      "type": "number",
      "nullable": true
    },
    "resolved_sig_id": {
      "label": "sigID",
      "type": "number",
      "nullable": true
    }
  }
}
