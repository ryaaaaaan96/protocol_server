        },
        "address": {
          "column": "V",
          "kind": "integer"
        },
        "scale": {
          "column": "K",
          "kind": "number",
          "default": 1
        },
        "access": {
          "column": "J",
          "kind": "text"
        },
        "register_type": {
          "value": "HOLDING"
