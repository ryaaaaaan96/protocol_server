    {
      "sheet": "UPM-DSP采集数据",
      "group": "DSP",
      "fields": {
        "name": {
          "column": "A",
          "kind": "text"
        },
        "internal_type": {
          "column": "C",
          "kind": "text"
        },
        "default_value": {
          "column": "F",
          "kind": "text"
        },
        "max_value": {
          "column": "G",
          "kind": "text"
        },
        "min_value": {
          "column": "H",
          "kind": "text"
        },
        "unit": {
          "column": "I",
          "kind": "text"
        },
