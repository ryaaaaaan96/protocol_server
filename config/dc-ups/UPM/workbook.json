        "flags": {
          "column": "P",
          "kind": "text",
          "default": "0",
          "cases": [
            {
              "when": {
                "column": "P",
                "equals": "※"
              },
              "value": "0"
            }
          ]
        },
        "callback": {
          "column": "T",
          "kind": "text",
          "default": "NULL",
          "cases": [
            {
              "when": {
                "column": "T",
                "equals": "※"
              },
              "value": "NULL"
            }
          ]
        }
      },
