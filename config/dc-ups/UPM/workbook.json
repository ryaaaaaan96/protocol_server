        "set_priority": {
          "column": "R",
          "kind": "integer",
          "null_values": [
            "",
            "※"
          ]
        },
        "scan_priority": {
          "column": "S",
          "kind": "integer",
          "null_values": [
            "",
            "※"
          ]
        }
      }
    }
  ],
  "transmit": [
    {
      "sheet": "UPM单板测点",
      "group": "LOCAL",
      "endpoint": "MODBUS_SERVICE",
      "reference": {
        "column": "Q",
        "kind": "text",
        "transform": "enum"
      },
      "conditions": [
        {
          "column": "O",
          "not_empty": true
        }
      ],
      "fields": {
        "upp_model": {
          "value": 0
        },
        "address": {
          "column": "O",
          "kind": "integer"
        },
        "scale": {
          "column": "H",
          "kind": "number",
          "default": 1
        },
        "access": {
          "column": "J",
          "kind": "text",
          "default": "RO"
        },
        "register_type": {
          "value": "HOLDING",
          "cases": [
            {
              "when": {
                "column": "U",
                "contains": "寄存器类型=0x04"
              },
              "value": "INPUT"
            },
            {
              "when": {
                "column": "U",
                "contains": "寄存器类型=0x03"
              },
              "value": "HOLDING"
            },
            {
              "when": {
                "column": "J",
                "equals": "RO"
              },
              "value": "INPUT"
            }
          ]
        }
      },
      "metadata": {
        "notes": {
          "column": "U",
          "kind": "text"
        }
      }
    },
    {
      "sheet": "UPM-DSP采集数据",
      "group": "DSP",
      "endpoint": "MODBUS_SERVICE",
