{
  "version": 1,
  "enabled": true,
  "label": "转发点表",
  "description": "LOCAL 和 DSP 内部点分别映射到 Modbus 或 UPP；Modbus 按设备基址展开，同一点可对应多个对外地址。",
  "columns": [
    "signal_name",
    "enum_name",
    "resolved_sig_id",
    "endpoint_name",
    "upp_model",
    "address",
    "wire_type",
    "wire_length",
    "register_type",
    "register_count",
    "scale",
    "access",
    "byte_order",
    "device_addresses"
  ],
  "editor": [
    "process_point_id",
    "endpoint_key",
    "upp_model",
    "address",
    "wire_type",
    "wire_length",
    "register_type",
    "scale",
    "access",
    "byte_order"
  ],
  "ordering": {
    "mode": "display",
    "group_by": [
      "endpoint_key",
      "group_key",
      "upp_model",
      "register_type"
    ]
  },
  "inline": {
    "upp_model": "upp_model",
    "address": "address",
    "wire_type": "wire_type",
    "wire_length": "wire_length",
    "register_type": "register_type",
    "scale": "scale",
    "access": "access",
    "byte_order": "byte_order"
  },
  "fields": {
    "enum_name": {
      "label": "ENMU"
    },
    "device_addresses": {
      "label": "设备地址"
    },
    "signal_name": {
      "label": "内部点"
    },
    "endpoint_name": {
      "label": "协议端点"
    },
    "process_point_id": {
      "label": "内部点",
      "type": "number",
      "reference": "process_points"
    },
    "endpoint_key": {
      "label": "协议端点",
      "reference": "endpoints"
    },
    "upp_model": {
      "label": "UPP 模型号",
      "type": "number",
      "default": 0
    },
    "address": {
      "label": "协议地址 / 偏移",
      "type": "number",
      "default": 0,
      "hint": "UPP 按字节；Modbus 按寄存器。DSP 模板为相对偏移，设备基址定义于 project.json。"
    },
    "wire_type": {
      "label": "通信类型",
      "options": [
        "U8",
        "U16",
        "S16",
        "U32",
        "S32",
        "F32",
        "STRING"
      ],
      "default": "U16"
    },
    "wire_length": {
      "label": "协议字节数",
      "type": "number",
      "default": 2
    },
    "scale": {
      "label": "精度",
      "type": "number",
      "default": 1
    },
    "access": {
      "label": "读写权限",
      "options": [
        "RO",
        "RW",
        "WO"
      ],
      "default": "RO"
    },
    "byte_order": {
      "label": "字节序",
      "type": "number",
      "default": 0
    },
    "register_type": {
      "label": "Modbus 寄存器区",
      "options": [
        "HOLDING",
        "INPUT"
      ],
      "default": "HOLDING"
    },
    "register_count": {
      "label": "Modbus 寄存器数量",
      "type": "number"
    },
    "resolved_sig_id": {
      "label": "sigID",
      "type": "number",
      "nullable": true
    }
  }
}
