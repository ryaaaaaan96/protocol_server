{
  "version": 1,
  "enabled": true,
  "label": "处理点表",
  "description": "LOCAL 本地测点与 DSP 采集点按模板维护；多个设备实例共用点定义，地址在项目 JSON 中配置。",
  "columns": [
    "name",
    "enum_name",
    "sig_id",
    "internal_type",
    "element_count",
    "byte_length",
    "unit",
    "default_value",
    "min_value",
    "max_value",
    "flags",
    "callback",
    "notes",
    "group_name",
    "device_addresses",
    "collection_count",
    "forward_count",
    "source_sig_id"
  ],
  "editor": [
    "name",
    "enum_name",
    "sig_id",
    "internal_type",
    "element_count",
    "unit",
    "default_value",
    "min_value",
    "max_value",
    "flags",
    "callback",
    "notes",
    "group_key"
  ],
  "ordering": {
    "mode": "display",
    "group_by": [
      "group_key"
    ]
  },
  "inline": {
    "name": "name",
    "enum_name": "enum_name",
    "sig_id": "sig_id",
    "internal_type": "internal_type",
    "element_count": "element_count",
    "unit": "unit",
    "default_value": "default_value",
    "min_value": "min_value",
    "max_value": "max_value",
    "flags": "flags",
    "callback": "callback",
    "notes": "notes"
  },
  "fields": {
    "name": {
      "label": "数据定义"
    },
    "enum_name": {
      "label": "ENMU"
    },
    "unit": {
      "label": "单位"
    },
    "notes": {
      "label": "备注"
    },
    "source_sig_id": {
      "label": "源 sigID"
    },
    "device_addresses": {
      "label": "设备地址"
    },
    "group_name": {
      "label": "设备模板"
    },
    "collection_count": {
      "label": "采集绑定数"
    },
    "forward_count": {
      "label": "转发绑定数"
    },
    "group_key": {
      "label": "设备模板",
      "reference": "native_groups"
    },
    "sig_id": {
      "label": "sigID",
      "type": "number",
      "nullable": true
    },
    "internal_type": {
      "label": "数据类型",
      "options": [
        "U8",
        "U16",
        "S16",
        "U32",
        "S32",
        "F32",
        "STRING"
      ],
      "default": "U16"
    },
    "element_count": {
      "label": "元素数量（字符串为字节数）",
      "type": "number",
      "default": 1
    },
    "byte_length": {
      "label": "内部字节数",
      "type": "number"
    },
    "default_value": {
      "label": "默认值",
      "nullable": true,
      "hint": "保持 Excel 原始值；未解析的符号在校验中提示。"
    },
    "min_value": {
      "label": "数据下限",
      "nullable": true,
      "hint": "保持 Excel 原始值；未解析的符号在校验中提示。"
    },
    "max_value": {
      "label": "数据上限",
      "nullable": true,
      "hint": "保持 Excel 原始值；未解析的符号在校验中提示。"
    },
    "flags": {
      "label": "ARM 配置参数",
      "default": "0"
    },
    "callback": {
      "label": "回调函数",
      "default": "NULL"
    }
  }
}
