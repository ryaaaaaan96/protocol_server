  "columns": [
    "signal_name",
    "context_name",
    "dev_id",
    "resolved_sig_id",
    "endpoint_name",
    "protocol",
    "transport",
    "field_name",
    "upp_model",
    "effective_address",
    "effective_type",
    "effective_length",
    "data_type",
    "scale",
    "poll_interval"
  ],
  "editor": [
