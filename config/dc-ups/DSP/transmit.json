{
  "version": 1,
  "enabled": true,
  "label": "DSP UPP转发表",
  "description": "按 DSP 内部数据的名称和分类展示 UPP 转发；模型号固定推导。calculation 脚本参考 Excel 计算协议字节数和偏移地址，保存前预览全部联动影响并校验。",
  "columns": [
    "signal_name",
    "variable_name",
    "category",
    "upp_model",
    "effective_address",
    "effective_length",
    "effective_type",
    "scale",
    "access"
  ],
  "editor": [
    "process_point_id",
    "endpoint_key",
    "wire_type",
    "scale",
    "access"
  ],
  "ordering": {
    "mode": "display",
    "group_by": [
      "endpoint_key",
      "upp_model"
    ]
  },
  "inline": {
    "scale": "scale",
    "access": "access",
    "signal_name": "process_point_id",
    "effective_type": "wire_type"
  },
  "fields": {
    "signal_name": {
      "label": "数据名称"
    },
    "process_point_id": {
      "label": "数据名称",
      "reference": "process_points",
      "type": "number",
      "hint": "通过固定记录 ID 关联 DSP 内部点；其数据分类决定模型，DateType 和 ArrayCnt 提供通信类型建议。"
    },
    "endpoint_key": {
      "label": "输出接口",
      "default": "UPP_SERVICE",
      "reference": "endpoints"
    },
    "effective_address": {
      "label": "UPP偏移地址"
    },
    "address": {
      "label": "UPP偏移地址",
      "type": "number",
      "default": 6,
      "hint": "由本表 calculation 脚本统一计算；界面拖动不改变协议顺序。"
    },
    "effective_type": {
      "label": "数据类型"
    },
    "wire_type": {
      "label": "数据类型",
      "options": [
        "U8",
        "U16",
        "S16",
        "U32",
        "S32",
        "F32",
        "STRING"
      ],
      "hint": "由 DateType 和 ArrayCnt 建议，可手动调整；转换方式由内部类型与通信类型自动确定，偏离建议时提示并校验。"
    },
    "effective_length": {
      "label": "UPP协议字节数"
    },
    "wire_length": {
      "label": "UPP协议字节数",
      "type": "number",
      "hint": "由本表 calculation 脚本按通信类型和内部总长度计算。"
    },
    "scale": {
      "label": "协议系数",
      "type": "number"
    },
    "access": {
      "label": "读写属性",
      "options": [
        "RO",
        "RW",
        "WO"
      ],
      "default": "RO"
    },
    "variable_name": {
      "label": "VariateName"
    },
    "sheet_type": {
      "label": "DateType"
    },
    "category": {
      "label": "数据分类",
      "hint": "由关联内部点的分类决定；需要变更时修改内部点，关联转发将同步分类并检查地址冲突。"
    },
    "recommended_wire_type": {
      "label": "建议数据类型"
    },
    "recommended_wire_length": {
      "label": "建议通信字节数"
    },
    "recommended_scale": {
      "label": "建议协议系数"
    },
    "recommended_conversion": {
      "label": "建议数据转换"
    },
    "upp_model": {
      "label": "UPP模型号",
      "hint": "由关联内部点的数据分类固定推导，不可单独编辑。"
    }
  },
  "calculation": {
    "engine": "javascript",
    "parameters": {
      "header_bytes": 6,
      "type_bytes": {
        "U8": 1,
        "U16": 2,
        "S16": 2,
        "U32": 4,
        "S32": 4,
        "F32": 4
      },
      "fixed_offsets": {
        "固件版本号版本": 48,
        "机器型号": 8,
        "机器版本号": 24,
        "序列号": 62,
        "机器型号编码": 94,
        "设备类型编码": 96
      }
    },
    "script_file": "transmit.js"
  }
}
