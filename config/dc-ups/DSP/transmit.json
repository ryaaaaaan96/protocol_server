{
  "version": 1,
  "enabled": true,
  "label": "DSP UPP转发表",
  "description": "来源为工作簿“UPM-DSP采集数据” sheet，本表维护 DSP 对外提供的 UPP 字段。同一内部点允许多条映射；UPM 侧采集配置暂不处理。",
  "columns": [
    "signal_name",
    "resolved_sig_id",
    "enum_name",
    "name",
    "upp_model",
    "effective_address",
    "data_type",
    "byte_length",
    "effective_type",
    "effective_length",
    "scale",
    "conversion",
    "access",
    "byte_order",
    "enabled"
  ],
  "editor": [
    "process_point_id",
    "endpoint_key",
    "name",
    "upp_model",
    "address",
    "wire_type",
    "wire_length",
    "scale",
    "access",
    "byte_order",
    "conversion",
    "enabled"
  ],
  "ordering": {
    "mode": "display",
    "group_by": []
  },
  "inline": {
    "name": "name",
    "upp_model": "upp_model",
    "scale": "scale",
    "access": "access",
    "byte_order": "byte_order",
    "conversion": "conversion",
    "enabled": "enabled",
    "signal_name": "process_point_id",
    "effective_address": "address",
    "effective_type": "wire_type",
    "effective_length": "wire_length"
  },
  "fields": {
    "signal_name": {
      "label": "DSP 内部点"
    },
    "process_point_id": {
      "label": "DSP 内部点",
      "reference": "process_points",
      "type": "number",
      "hint": "通过固定记录 ID 关联，sigID 和枚举随内部点更新。"
    },
    "resolved_sig_id": {
      "label": "sigID"
    },
    "enum_name": {
      "label": "内部枚举"
    },
    "endpoint_key": {
      "label": "输出接口",
      "default": "UPP_SERVICE",
      "reference": "endpoints"
    },
    "name": {
      "label": "转发字段名称"
    },
    "upp_model": {
      "label": "UPP 模型",
      "type": "number",
      "default": 0
    },
    "effective_address": {
      "label": "实际字节偏移"
    },
    "address": {
      "label": "字节偏移",
      "type": "number",
      "default": 6,
      "hint": "UPP 帧头占 6 字节。拖动仅调整显示顺序，不会重算偏移。"
    },
    "data_type": {
      "label": "内部类型"
    },
    "byte_length": {
      "label": "内部字节数"
    },
    "effective_type": {
      "label": "通信类型"
    },
    "wire_type": {
      "label": "通信类型",
      "options": [
        "U8",
        "U16",
        "S16",
        "U32",
        "S32",
        "F32",
        "STRING"
      ],
      "default": "F32"
    },
    "effective_length": {
      "label": "通信字节数"
    },
    "wire_length": {
      "label": "通信字节数",
      "type": "number",
      "default": 4
    },
    "scale": {
      "label": "协议系数",
      "type": "number",
      "default": 1
    },
    "access": {
      "label": "读写属性",
      "options": [
        "RO",
        "RW",
        "WO"
      ],
      "default": "RO"
    },
    "byte_order": {
      "label": "字节序",
      "options": [
        "0",
        "1",
        "2",
        "3"
      ],
      "default": 0,
      "type": "number"
    },
    "conversion": {
      "label": "数据转换",
      "options": [
        "identity",
        "fixed_point",
        "array_bytes"
      ],
      "default": "identity",
      "hint": "identity：直接映射；fixed_point：定点缩放；array_bytes：数组字节映射。"
    },
    "enabled": {
      "label": "启用",
      "type": "boolean",
      "default": true
    }
  }
}
