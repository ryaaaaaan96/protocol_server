{
  "version": 1,
  "enabled": true,
  "label": "DSP UPP转发表",
  "description": "按 DSP 内部数据的名称和分类展示 UPP 转发；模型号由分类固定推导，所有记录参与转发。数据类型按 DateType 和 ArrayCnt 给出建议，可按通信协议调整；转换方式自动确定，提交前校验类型、长度、系数及地址。",
  "columns": [
    "signal_name",
    "variable_name",
    "category",
    "upp_model",
    "effective_address",
    "effective_length",
    "effective_type",
    "scale",
    "access"
  ],
  "editor": [
    "process_point_id",
    "endpoint_key",
    "address",
    "wire_type",
    "wire_length",
    "scale",
    "access"
  ],
  "ordering": {
    "mode": "display",
    "group_by": [
      "endpoint_key",
      "upp_model"
    ]
  },
  "inline": {
    "scale": "scale",
    "access": "access",
    "signal_name": "process_point_id",
    "effective_address": "address",
    "effective_type": "wire_type",
    "effective_length": "wire_length"
  },
  "fields": {
    "signal_name": {
      "label": "数据名称"
    },
    "process_point_id": {
      "label": "数据名称",
      "reference": "process_points",
      "type": "number",
      "hint": "通过固定记录 ID 关联 DSP 内部点；其数据分类决定模型，DateType 和 ArrayCnt 提供通信类型建议。"
    },
    "endpoint_key": {
      "label": "输出接口",
      "default": "UPP_SERVICE",
      "reference": "endpoints"
    },
    "effective_address": {
      "label": "UPP偏移地址"
    },
    "address": {
      "label": "UPP偏移地址",
      "type": "number",
      "default": 6,
      "hint": "UPP 帧头占 6 字节。拖动仅调整显示顺序，不会重算偏移。"
    },
    "effective_type": {
      "label": "数据类型"
    },
    "wire_type": {
      "label": "数据类型",
      "options": [
        "U8",
        "U16",
        "S16",
        "U32",
        "S32",
        "F32",
        "STRING"
      ],
      "hint": "由 DateType 和 ArrayCnt 建议，可手动调整；转换方式由内部类型与通信类型自动确定，偏离建议时提示并校验。"
    },
    "effective_length": {
      "label": "UPP协议字节数"
    },
    "wire_length": {
      "label": "UPP协议字节数",
      "type": "number",
      "hint": "当前转发字段在 UPP 协议中的实际字节数；与内部存储字节数分别配置并校验。"
    },
    "scale": {
      "label": "协议系数",
      "type": "number"
    },
    "access": {
      "label": "读写属性",
      "options": [
        "RO",
        "RW",
        "WO"
      ],
      "default": "RO"
    },
    "variable_name": {
      "label": "VariateName"
    },
    "sheet_type": {
      "label": "DateType"
    },
    "category": {
      "label": "数据分类",
      "hint": "由关联内部点的分类决定；需要变更时修改内部点，关联转发将同步分类并检查地址冲突。"
    },
    "recommended_wire_type": {
      "label": "建议数据类型"
    },
    "recommended_wire_length": {
      "label": "建议通信字节数"
    },
    "recommended_scale": {
      "label": "建议协议系数"
    },
    "recommended_conversion": {
      "label": "建议数据转换"
    },
    "upp_model": {
      "label": "UPP模型号",
      "hint": "由关联内部点的数据分类固定推导，不可单独编辑。"
    }
  }
}
