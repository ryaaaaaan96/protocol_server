{
  "version": 1,
  "enabled": true,
  "label": "DSP UPP转发表",
  "description": "按 DSP 内部数据的分类展示 UPP 转发；型号由分类固定推导。数据类型按 DateType 和 ArrayCnt 给出建议，可按通信协议调整，提交前显示偏离建议的提示并校验转换、长度及地址。",
  "columns": [
    "signal_name",
    "variable_name",
    "name",
    "category",
    "effective_address",
    "sheet_type",
    "byte_length",
    "effective_type",
    "effective_length",
    "scale",
    "conversion",
    "access",
    "byte_order",
    "enabled"
  ],
  "editor": [
    "process_point_id",
    "endpoint_key",
    "name",
    "address",
    "wire_type",
    "wire_length",
    "scale",
    "access",
    "byte_order",
    "conversion",
    "enabled"
  ],
  "ordering": {
    "mode": "display",
    "group_by": [
      "endpoint_key",
      "upp_model"
    ]
  },
  "inline": {
    "name": "name",
    "scale": "scale",
    "access": "access",
    "byte_order": "byte_order",
    "conversion": "conversion",
    "enabled": "enabled",
    "signal_name": "process_point_id",
    "effective_address": "address",
    "effective_type": "wire_type",
    "effective_length": "wire_length"
  },
  "fields": {
    "signal_name": {
      "label": "DSP 内部点"
    },
    "process_point_id": {
      "label": "DSP 内部点",
      "reference": "process_points",
      "type": "number",
      "hint": "通过固定记录 ID 关联 DSP 内部点；其数据分类决定模型，DateType 和 ArrayCnt 提供通信类型建议。"
    },
    "endpoint_key": {
      "label": "输出接口",
      "default": "UPP_SERVICE",
      "reference": "endpoints"
    },
    "name": {
      "label": "转发字段名称"
    },
    "effective_address": {
      "label": "实际字节偏移"
    },
    "address": {
      "label": "字节偏移",
      "type": "number",
      "default": 6,
      "hint": "UPP 帧头占 6 字节。拖动仅调整显示顺序，不会重算偏移。"
    },
    "byte_length": {
      "label": "内部字节数"
    },
    "effective_type": {
      "label": "数据类型"
    },
    "wire_type": {
      "label": "数据类型",
      "options": [
        "U8",
        "U16",
        "S16",
        "U32",
        "S32",
        "F32",
        "STRING"
      ],
      "hint": "由 DateType 和 ArrayCnt 建议，可手动调整；偏离建议时提示，仍须满足通信长度和转换规则。"
    },
    "effective_length": {
      "label": "通信字节数"
    },
    "wire_length": {
      "label": "通信字节数",
      "type": "number"
    },
    "scale": {
      "label": "协议系数",
      "type": "number"
    },
    "access": {
      "label": "读写属性",
      "options": [
        "RO",
        "RW",
        "WO"
      ],
      "default": "RO"
    },
    "byte_order": {
      "label": "字节序",
      "options": [
        "0",
        "1",
        "2",
        "3"
      ],
      "default": 0,
      "type": "number"
    },
    "conversion": {
      "label": "数据转换",
      "options": [
        "identity",
        "fixed_point",
        "array_bytes"
      ],
      "hint": "identity：直接映射；fixed_point：定点缩放；array_bytes：数组字节映射。"
    },
    "enabled": {
      "label": "启用",
      "type": "boolean",
      "default": true
    },
    "variable_name": {
      "label": "VariateName"
    },
    "sheet_type": {
      "label": "DateType"
    },
    "category": {
      "label": "数据分类",
      "hint": "由关联内部点的分类决定；需要变更时修改内部点，关联转发将同步分类并检查地址冲突。"
    },
    "recommended_wire_type": {
      "label": "建议数据类型"
    },
    "recommended_wire_length": {
      "label": "建议通信字节数"
    },
    "recommended_scale": {
      "label": "建议协议系数"
    },
    "recommended_conversion": {
      "label": "建议数据转换"
    }
  }
}
