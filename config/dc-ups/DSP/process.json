{
  "version": 1,
  "enabled": true,
  "label": "DSP内部数据",
  "description": "按「DSP内部数据」sheet 定义内部参数；DSP 内部没有 sigID。数据类型建议和 UPP 模型号在后台推导：通信类型仅在转发表配置，模型号固定由数据分类决定。修改分类会同步关联转发，提交前校验地址及权限。",
  "columns": [
    "name",
    "variable_name",
    "sheet_type",
    "enum_table",
    "display_digits",
    "type_length",
    "element_count",
    "byte_length",
    "default_value",
    "max_value",
    "min_value",
    "unit",
