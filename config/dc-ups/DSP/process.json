{
  "version": 1,
  "enabled": true,
  "label": "DSP内部数据",
  "description": "按「DSP内部数据」sheet 定义内部参数；DSP 内部没有 sigID。数据类型建议和 UPP 模型号在后台推导：通信类型仅在转发表配置，模型号固定由数据分类决定。修改分类会同步关联转发，提交前校验地址及权限。",
  "columns": [
    "name",
    "variable_name",
    "sheet_type",
    "enum_table",
    "display_digits",
    "type_length",
    "element_count",
    "byte_length",
    "default_value",
    "max_value",
    "min_value",
    "unit",
    "access",
    "ram",
    "flash",
    "eeprom",
    "calibration",
    "structure",
    "cpu",
    "precision",
    "upload_level",
    "category",
    "notes"
  ],
  "editor": [
    "name",
    "variable_name",
    "sheet_type",
    "enum_table",
    "display_digits",
    "element_count",
    "default_value",
    "max_value",
    "min_value",
    "unit",
    "access",
    "ram",
    "flash",
    "eeprom",
    "calibration",
    "structure",
    "cpu",
    "upload_level",
    "category",
    "notes"
  ],
  "ordering": {
    "mode": "display",
    "group_by": []
  },
  "inline": {
    "name": "name",
    "variable_name": "variable_name",
    "sheet_type": "sheet_type",
    "enum_table": "enum_table",
    "display_digits": "display_digits",
    "element_count": "element_count",
    "default_value": "default_value",
    "max_value": "max_value",
    "min_value": "min_value",
    "unit": "unit",
    "access": "access",
    "ram": "ram",
    "flash": "flash",
    "eeprom": "eeprom",
    "calibration": "calibration",
    "structure": "structure",
    "cpu": "cpu",
    "upload_level": "upload_level",
    "category": "category",
    "notes": "notes"
  },
  "fields": {
    "name": {
      "label": "数据名称"
    },
    "variable_name": {
      "label": "VariateName",
      "hint": "DSP 内部变量名；系统通过固定记录 ID 关联转发，修改变量名不会断开引用。"
    },
    "sheet_type": {
      "label": "DateType",
      "options": [
        "Sys_U8",
        "Sys_U16",
        "Sys_S16",
        "Sys_U32",
        "Sys_S32",
        "Sys_F32"
      ],
      "default": "Sys_F32"
    },
    "enum_table": {
      "label": "EnumTab",
      "default": "",
      "multiline": true
    },
    "display_digits": {
      "label": "DisplayDigit",
      "type": "number",
      "default": 0,
      "hint": "显示小数位数，填写 0～8 的整数；精度按 10 的负次幂计算。"
    },
    "type_length": {
      "label": "DataType\nLength",
      "hint": "由 DateType 计算单个元素字节数。"
    },
    "element_count": {
      "label": "ArrayCnt",
      "type": "number",
      "default": 1,
      "hint": "数组元素数量；标量填写 1。"
    },
    "byte_length": {
      "label": "Total Length",
      "hint": "由 DataType Length × ArrayCnt 计算。"
    },
    "default_value": {
      "label": "DefaultValue",
      "nullable": true,
      "default": ""
    },
    "max_value": {
      "label": "MaxValue",
      "nullable": true,
      "default": ""
    },
    "min_value": {
      "label": "MinValue",
      "nullable": true,
      "default": ""
    },
    "unit": {
      "label": "Unit",
      "nullable": true,
      "default": ""
    },
    "access": {
      "label": "RW",
      "options": [
        "RO",
        "RW"
      ],
      "default": "RW"
    },
    "ram": {
      "label": "RAM",
      "options": [
        "Y",
        "N"
      ],
      "default": "N"
    },
    "flash": {
      "label": "FLASH",
      "options": [
        "Y",
        "N"
      ],
      "default": "Y"
    },
    "eeprom": {
      "label": "EEPROM",
      "options": [
        "Y",
        "N"
      ],
      "default": "N"
    },
    "calibration": {
      "label": "Calibration",
      "options": [
        "Y",
        "N"
      ],
      "default": "Y"
    },
    "structure": {
      "label": "STRUCT",
      "default": ""
    },
    "cpu": {
      "label": "数据来自CPU",
      "options": [
        "CPU1",
        "CPU2"
      ],
      "default": "CPU2"
    },
    "precision": {
      "label": "精度",
      "hint": "由 DisplayDigit 计算，与原 sheet 公式一致。"
    },
    "sheet_data_type": {
      "label": "数据类型",
      "hint": "后台推导的建议通信类型，仅在转发表显示和配置；允许合法的人工覆盖，提交时提示。"
    },
    "upload_level": {
      "label": "数据上传\n等级",
      "options": [
        "0：不上传",
        "1：上传至UPM",
        "2：UPM进行轮询",
        "3：CSU进行轮询"
      ],
      "default": "0：不上传"
    },
    "category": {
      "label": "数据分类",
      "options": [
        "",
        "系统参数1",
        "系统参数2",
        "任务级观测量",
        "中断级观测量",
        "控制参数设置",
        "任务级标定量"
      ],
      "default": "",
      "hint": "决定关联转发的数据分类及 UPP 模型；修改后会联动所有关联转发，地址冲突时整笔修改不保存。"
    },
    "sheet_upp_model": {
      "label": "UPP\n模型号",
      "hint": "后台按数据分类固定推导，不可独立修改；转发表按数据分类展示。"
    },
    "notes": {
      "label": "备注",
      "nullable": true,
      "default": "",
      "multiline": true
    }
  }
}
