    "eeprom",
    "calibration",
    "structure",
    "cpu",
    "precision",
    "upload_level",
    "category",
    "notes"
  ],
  "editor": [
    "name",
    "variable_name",
    "sheet_type",
    "enum_table",
    "display_digits",
    "element_count",
