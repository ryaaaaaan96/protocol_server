{
  "version": 1,
  "enabled": true,
  "label": "转发点表",
  "description": "按枚举排序连续分配 Modbus 寄存器，规则见 transmit.js。",
  "columns": [
    "signal_name",
    "address",
    "wire_type",
    "wire_length",
    "scale",
    "access"
  ],
  "editor": [
    "process_point_id",
    "endpoint_key",
    "wire_type",
    "scale",
    "access"
  ],
  "ordering": {
    "mode": "display",
    "group_by": [
      "endpoint_key"
    ]
  },
  "inline": {
    "wire_type": "wire_type",
    "scale": "scale",
    "access": "access"
  },
  "fields": {
    "signal_name": {
      "label": "内部点"
    },
    "process_point_id": {
      "label": "内部点",
      "reference": "process_points",
      "type": "number"
    },
    "endpoint_key": {
      "label": "协议端点",
      "reference": "endpoints"
    },
    "address": {
      "label": "协议地址",
      "type": "number",
      "default": 6
    },
    "wire_type": {
      "label": "通信类型",
      "options": [
        "U8",
        "U16",
        "S16",
        "U32",
        "S32",
        "F32",
        "STRING"
      ],
      "default": "U16"
    },
    "wire_length": {
      "label": "协议字节数",
      "type": "number",
      "default": 2
    },
    "scale": {
      "label": "协议系数",
      "type": "number",
      "default": 1
    },
    "access": {
      "label": "读写属性",
      "options": [
        "RO",
        "RW"
      ],
      "default": "RO"
    }
  },
  "calculation": {
    "engine": "javascript",
    "script_file": "transmit.js",
    "parameters": {
      "base_address": 1000,
      "type_bytes": {
        "U8": 1,
        "U16": 2,
        "S16": 2,
        "U32": 4,
        "S32": 4,
        "F32": 4
      }
    }
  },
  "presentation": {
    "computed_dependencies": {
      "address": [
        "wire_type",
        "process_point_id"
      ],
      "wire_length": [
        "wire_type",
        "process_point_id"
      ]
    }
  }
}
